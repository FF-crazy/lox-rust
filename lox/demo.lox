
fun combinations(n, k) {
  var count = 0;
  fun backtrack(start, depth, code) {
    if depth == k {
      println(code);
      count = count + 1;
      return;
    }
    for (var i = start; i <= n; i = i + 1) {
      backtrack(i + 1, depth + 1, code * 10 + i);
    }
  }

  println("combinations:");
  backtrack(1, 0, 0);
  print("total: ");
  println(count);
}

combinations(4, 3);
